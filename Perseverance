function stopTSJWSequence()
    if State.TSJWThread then
        task.cancel(State.TSJWThread)
        State.TSJWThread = nil
    end
    State.TSJWRemainingSeconds = 0
end

function executeTSJWMatchmaking()
    State.TSJWThread = task.spawn(function()
        State.TSJWRemainingSeconds = State.TSJWWaitSeconds

        while State.TSJWRemainingSeconds > 0 and State.AutoJoinTSJW do
            task.wait(1)
            State.TSJWRemainingSeconds = State.TSJWRemainingSeconds - 1
        end

        if not State.AutoJoinTSJW then return end

        local remote = ReplicatedStorage:WaitForChild("AV_LOBBY_MATCHMAKING_V1_BLINK_RELIABLE_REMOTE", 10) :: RemoteEvent?
        if remote and remote:IsA("RemoteEvent") then
            pcall(function()
                local args1 = {
                    buffer.fromstring("\000\000\001\vLegendStage\006Stage3\004Act1")
                }
                remote:FireServer(unpack(args1))
            end)

            task.wait(2.5)

            if not State.AutoJoinTSJW then return end

            pcall(function()
                local args2 = {
                    buffer.fromstring("\005")
                }
                remote:FireServer(unpack(args2))
            end)
        end
    end)
end

if State.AutoJoinTSJW then
    executeTSJWMatchmaking()
end

