end

local function getStatueInteractives(statueModel: Instance): (BasePart?, ProximityPrompt?)
    local part = statueModel:FindFirstChild("PromptAnchor") or statueModel:FindFirstChild("HumanoidRootPart")
    if not part or not part:IsA("BasePart") then
        part = statueModel:FindFirstChildWhichIsA("BasePart", true)
    end

    local prompt = nil
    local anchor = statueModel:FindFirstChild("PromptAnchor")
    if anchor then
        prompt = anchor:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if not prompt then
        prompt = statueModel:FindFirstChildWhichIsA("ProximityPrompt", true)
    end

    return part :: BasePart?, prompt
end

local function processAwakeStatue(statueModel: Instance): boolean
    local targetPart, prompt = getStatueInteractives(statueModel)
    if not targetPart then return false end

    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not rootPart then return false end

    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = CFrame.lookAt(targetPart.Position + Vector3.new(0, 0.5, 3.5), targetPart.Position)

    if prompt and prompt.Enabled then
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 50
        prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow

        local holdTime = if prompt.HoldDuration > 0 then prompt.HoldDuration + 0.1 else 0.15
        local key = if prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then prompt.KeyboardKeyCode else Enum.KeyCode.E

        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(holdTime)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
        return true
    end

    return false
end

