local function createToggleButton(text: string, posY: number, defaultState: boolean, callback: (boolean, TextButton) -> ()): TextButton
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -24, 0, 34)
    btn.Position = UDim2.fromOffset(12, posY)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.Parent = MainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Parent = btn

    local isEnabled = defaultState

    local function updateVisual()
        if isEnabled then
            btn.BackgroundColor3 = Color3.fromRGB(40, 145, 85)
            btn.Text = text .. ": ON"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            stroke.Color = Color3.fromRGB(70, 200, 115)
        else
            btn.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
            btn.Text = text .. ": OFF"
            btn.TextColor3 = Color3.fromRGB(210, 210, 220)
            stroke.Color = Color3.fromRGB(70, 70, 90)
        end
    end

    updateVisual()

    btn.MouseButton1Click:Connect(function()
        isEnabled = not isEnabled
        updateVisual()
        callback(isEnabled, btn)
    end)

    return btn
end

