-- MODULE 2: AUTO JOIN TSJW QUEST
local tsjwButton: TextButton? = nil

local function stopTSJWSequence()
    if State.TSJWThread then
        task.cancel(State.TSJWThread)
        State.TSJWThread = nil
    end
    State.TSJWRemainingSeconds = 0
    if tsjwButton and not State.AutoJoinTSJW then
        tsjwButton.Text = "Auto Join TSJW Quest: OFF"
    end
end

local function executeTSJWMatchmaking()
    State.TSJWThread = task.spawn(function()
        State.TSJWRemainingSeconds = State.TSJWWaitSeconds

        while State.TSJWRemainingSeconds > 0 and State.AutoJoinTSJW do
            if tsjwButton then
                tsjwButton.Text = string.format("TSJW Quest: Đang chờ (%ds)", State.TSJWRemainingSeconds)
            end
            task.wait(1)
            State.TSJWRemainingSeconds = State.TSJWRemainingSeconds - 1
        end

        if not State.AutoJoinTSJW then return end

        if tsjwButton then
            tsjwButton.Text = "TSJW Quest: Đang gửi lệnh tạo phòng..."
        end

        local remote = ReplicatedStorage:WaitForChild("AV_LOBBY_MATCHMAKING_V1_BLINK_RELIABLE_REMOTE", 10) :: RemoteEvent?
        if remote and remote:IsA("RemoteEvent") then
            -- BƯỚC 1: Gửi lệnh Matchmaking chọn LegendStage Stage3 Act1
            pcall(function()
                local args1 = {
                    buffer.fromstring("\000\000\001\vLegendStage\006Stage3\004Act1")
                }
                remote:FireServer(unpack(args1))
            end)

            task.wait(2.5) -- Đệm 2.5s để server đồng bộ phòng trước khi gửi lệnh Start

            if not State.AutoJoinTSJW then return end

            if tsjwButton then
                tsjwButton.Text = "TSJW Quest: Đang Start trận..."
            end

            -- BƯỚC 2: Gửi lệnh bắt đầu trận đấu
            pcall(function()
                local args2 = {
                    buffer.fromstring("\005")
                }
                remote:FireServer(unpack(args2))
            end)

            task.wait(2.0)
            if tsjwButton and State.AutoJoinTSJW then
                tsjwButton.Text = "TSJW Quest: Đã gửi lệnh (Hoàn tất)"
            end
        else
            if tsjwButton then
                tsjwButton.Text = "TSJW Quest: Không tìm thấy Remote"
            end
        end
    end)
end

