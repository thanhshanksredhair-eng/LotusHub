local function parseWavesAmountString(str: string): number?
    if not str or str == "" then return nil end
    local wave = string.match(str, "^%s*(%d+)")
    if wave then return tonumber(wave) end
    local cleaned = string.gsub(str, "<[^>]+>", "")
    local fallback = string.match(cleaned, "(%d+)%s*/")
    return fallback and tonumber(fallback) or nil
end

local function getExactWaveNumber(): number
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return State.CurrentWave end
    local hud = pGui:FindFirstChild("HUD")
    if hud then
        local map = hud:FindFirstChild("Map")
        if map then
            local wavesAmount = map:FindFirstChild("WavesAmount") :: TextLabel?
            if wavesAmount and wavesAmount:IsA("TextLabel") then
                local parsed = parseWavesAmountString(wavesAmount.Text)
                if parsed then return parsed end
            end
        end
    end
    return State.CurrentWave
end

local function getStatuesFolder(): Instance?
    local map = workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Statues") or nil
end

local function getStatueInteractives(statueModel: Instance): (BasePart?, ProximityPrompt?)
    local part = statueModel:FindFirstChild("PromptAnchor") or statueModel:FindFirstChild("HumanoidRootPart")
    if not part or not part:IsA("BasePart") then
        part = statueModel:FindFirstChildWhichIsA("BasePart", true)
    end
    local prompt = nil
    local anchor = statueModel:FindFirstChild("PromptAnchor")
    if anchor then prompt = anchor:FindFirstChildWhichIsA("ProximityPrompt", true) end
    if not prompt then prompt = statueModel:FindFirstChildWhichIsA("ProximityPrompt", true) end
    return part :: BasePart?, prompt
end

local function processAwakeStatue(statueModel: Instance): boolean
    local targetPart, prompt = getStatueInteractives(statueModel)
    if not targetPart then return false end

    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not rootPart then return false end

    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = CFrame.lookAt(targetPart.Position + Vector3.new(0, 0.5, 3.5), targetPart.Position)

    if prompt and prompt.Enabled then
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 50
        prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow

        local holdTime = if prompt.HoldDuration > 0 then prompt.HoldDuration + 0.1 else 0.15
        local key = if prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then prompt.KeyboardKeyCode else Enum.KeyCode.E

        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(holdTime)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
        return true
    end
    return false
end

local function getMapEffectsFolder(): Instance?
    local cam = workspace:FindFirstChild("Camera") or workspace.CurrentCamera
    if not cam then return nil end
    local clientWorld = cam:FindFirstChild("ClientWorld")
    return clientWorld and clientWorld:FindFirstChild("MapEffects") or nil
end

local function getMobPivotPart(model: Instance): BasePart?
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    if model:IsA("Model") and model.PrimaryPart then return model.PrimaryPart end
    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function acquireNextMob(folder: Instance): Instance?
    local validModels = {}
    for _, child in ipairs(folder:GetChildren()) do
        if getMobPivotPart(child) ~= nil then table.insert(validModels, child) end
    end
    table.sort(validModels, function(a, b) return a.Name < b.Name end)
    return validModels[1]
end

local function triggerOptimizedArise(model: Instance)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local prompt = nil
    if hrp then
        local anchor = hrp:FindFirstChild("ArisePromptAnchor")
        if anchor then prompt = anchor:FindFirstChild("MonarchArise") end
    end
    if not prompt then prompt = model:FindFirstChild("MonarchArise", true) end

    local keyToPress = Enum.KeyCode.E
    local holdTime = 0.12
    if prompt and prompt:IsA("ProximityPrompt") then
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 50
        if prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then keyToPress = prompt.KeyboardKeyCode end
        if prompt.HoldDuration > 0 then holdTime = prompt.HoldDuration + 0.05 end
    end

    task.spawn(function()
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyToPress, false, game)
            task.wait(holdTime)
            VirtualInputManager:SendKeyEvent(false, keyToPress, false, game)
        end)
    end)
end

