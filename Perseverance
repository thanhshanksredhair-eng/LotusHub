-- 3. TRUY XUẤT CHUẨN XÁC WAVESAMOUNT (O(1))
-- ==========================================
local function parseWavesAmountString(str: string): number?
    if not str or str == "" then return nil end

    local wave = string.match(str, "^%s*(%d+)")
    if wave then
        return tonumber(wave)
    end

    local cleaned = string.gsub(str, "<[^>]+>", "")
    local fallback = string.match(cleaned, "(%d+)%s*/")
    if fallback then
        return tonumber(fallback)
    end

    return nil
end

local function getExactWaveNumber(): number
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return State.CurrentWave end

    local hud = pGui:FindFirstChild("HUD")
    if hud then
        local map = hud:FindFirstChild("Map")
        if map then
            local wavesAmount = map:FindFirstChild("WavesAmount") :: TextLabel?
            if wavesAmount and wavesAmount:IsA("TextLabel") then
                local parsed = parseWavesAmountString(wavesAmount.Text)
                if parsed then
                    return parsed
                end
            end
        end
    end

    return State.CurrentWave
end

