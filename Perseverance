-- Trích xuất hoặc lấy Asset cho Logo hoa sen chuẩn của LotusHub
local function resolveLotusLogoAsset(): string
    if typeof(isfile) == "function" and isfile(LOGO_FILENAME) and typeof(getcustomasset) == "function" then
        return getcustomasset(LOGO_FILENAME)
    end

    if LOGO_RAW_URL ~= "" and typeof(writefile) == "function" and typeof(getcustomasset) == "function" then
        local success, res = pcall(function()
            return game:HttpGet(LOGO_RAW_URL)
        end)
        if success and res and #res > 0 then
            pcall(writefile, LOGO_FILENAME, res)
            return getcustomasset(LOGO_FILENAME)
        end
    end

    -- Fallback asset nếu chưa tạo file cục bộ
    return "rbxassetid://107233469599938"
end

local function saveConfigFile()
    local data = {
        AutoTele = State.AutoTele,
        AutoArise = State.AutoArise,
        AntiAFK = State.AntiAFK,
        AutoJoinTSJW = State.AutoJoinTSJW,
        AutoAwake = State.AutoAwake,
        ResetPerWave = State.ResetPerWave,
        TargetStatue = State.TargetStatue,
        TargetWave = State.TargetWave,
        CycleIndex = State.CycleIndex,
    }
    local success, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if success and encoded and typeof(writefile) == "function" then
        pcall(writefile, CONFIG_FILE, encoded)
    end
end

local function loadConfigFile()
    if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return end
    local exists = false
    pcall(function() exists = isfile(CONFIG_FILE) end)
    if not exists then return end

    local readSuccess, content = pcall(readfile, CONFIG_FILE)
    if not readSuccess or not content or content == "" then return end

    local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if decodeSuccess and typeof(decoded) == "table" then
        if decoded.AutoTele ~= nil then State.AutoTele = decoded.AutoTele end
        if decoded.AutoArise ~= nil then State.AutoArise = decoded.AutoArise end
        if decoded.AntiAFK ~= nil then State.AntiAFK = decoded.AntiAFK end
        if decoded.AutoJoinTSJW ~= nil then State.AutoJoinTSJW = decoded.AutoJoinTSJW end
        if decoded.AutoAwake ~= nil then State.AutoAwake = decoded.AutoAwake end
        if decoded.ResetPerWave ~= nil then State.ResetPerWave = decoded.ResetPerWave end
        if decoded.TargetStatue ~= nil then State.TargetStatue = decoded.TargetStatue end
        if decoded.TargetWave ~= nil then State.TargetWave = decoded.TargetWave end
        if decoded.CycleIndex ~= nil then State.CycleIndex = decoded.CycleIndex end
    end
end

