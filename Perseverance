local activeTabName = "TSJW"
local tabButtons = {}

local function selectTab(targetTab: string)
    activeTabName = targetTab
    TSJWPage.Visible = (targetTab == "TSJW")
    MiscPage.Visible = (targetTab == "Misc")

    for name, btn in pairs(tabButtons) do
        local indicator = btn:FindFirstChild("Indicator") :: Frame?
        if name == targetTab then
            btn.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            if indicator then indicator.Visible = true end
        else
            btn.BackgroundTransparency = 1
            btn.TextColor3 = Color3.fromRGB(150, 150, 165)
            if indicator then indicator.Visible = false end
        end
    end
end

