-- ==========================================
local mainLoopConnection: RBXScriptConnection? = nil
local waveChangedConn: RBXScriptConnection? = nil

local function handleMatchOrWaveTransition(oldWave: number, newWave: number)
    if newWave < oldWave then
        if State.TargetStatue == "Cycle (Mace->Sword->God)" then
            State.CycleIndex = State.CycleIndex + 1
            if State.CycleIndex > #CycleSequence then
                State.CycleIndex = 1
            end
            updateStatueBtnText()
        end
        State.HasAwakenedThisMatch = false
        table.clear(State.AwakenedStatues)
    elseif State.ResetPerWave then
        table.clear(State.AwakenedStatues)
    end
end

local function setupWaveListener()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return end
    local hud = pGui:FindFirstChild("HUD")
    if not hud then return end
    local map = hud:FindFirstChild("Map")
    if not map then return end
    local wavesAmount = map:FindFirstChild("WavesAmount") :: TextLabel?

    if wavesAmount and wavesAmount:IsA("TextLabel") then
        if waveChangedConn then waveChangedConn:Disconnect() end
        waveChangedConn = wavesAmount:GetPropertyChangedSignal("Text"):Connect(function()
            local newWave = parseWavesAmountString(wavesAmount.Text)
            if newWave and newWave ~= State.CurrentWave then
                handleMatchOrWaveTransition(State.CurrentWave, newWave)
                State.CurrentWave = newWave
                WaveStatusLabel.Text = string.format("Wave Hiện Tại: %d | Đích: Wave %d", State.CurrentWave, State.TargetWave)
            end
        end)
    end
end

setupWaveListener()

mainLoopConnection = RunService.Heartbeat:Connect(function()
    if not State.IsRunning then return end

    local now = os.clock()

    local liveWave = getExactWaveNumber()
    if liveWave ~= State.CurrentWave then
        handleMatchOrWaveTransition(State.CurrentWave, liveWave)
        State.CurrentWave = liveWave
        WaveStatusLabel.Text = string.format("Wave Hiện Tại: %d | Đích: Wave %d", State.CurrentWave, State.TargetWave)
    end

    if State.AntiAFK and (now - State.LastAfkPulse >= State.AfkPulseInterval) then
        State.LastAfkPulse = now
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
        end)
    end

    local isWaveMatched = (State.CurrentWave >= State.TargetWave)

    if State.AutoAwake and isWaveMatched then
        local statuesFolder = getStatuesFolder()
        if statuesFolder then
            local statuesToProcess = {}

            if State.TargetStatue == "Cycle (Mace->Sword->God)" then
                local currentCycleTarget = CycleSequence[State.CycleIndex]
                if not State.AwakenedStatues[currentCycleTarget] and not State.HasAwakenedThisMatch then
                    local st = statuesFolder:FindFirstChild(currentCycleTarget)
                    if st then table.insert(statuesToProcess, st) end
                end
            elseif State.TargetStatue == "All" then
                for _, sName in ipairs(StatueList) do
                    if sName ~= "All" and not sName:find("Cycle") and not State.AwakenedStatues[sName] then
                        local st = statuesFolder:FindFirstChild(sName)
                        if st then table.insert(statuesToProcess, st) end
                    end
                end
            else
                if not State.AwakenedStatues[State.TargetStatue] then
                    local st = statuesFolder:FindFirstChild(State.TargetStatue)
                    if st then table.insert(statuesToProcess, st) end
                end
            end

            if #statuesToProcess > 0 then
                State.IsAwaking = true
                local targetStatueModel = statuesToProcess[1]
                StatusLabel.Text = "Đang Awake: " .. targetStatueModel.Name

                local success = processAwakeStatue(targetStatueModel)
                if success then
                    task.wait(1.0)
                    local _, pCheck = getStatueInteractives(targetStatueModel)
                    if not pCheck or not pCheck.Enabled then
                        State.AwakenedStatues[targetStatueModel.Name] = true
                        if State.TargetStatue == "Cycle (Mace->Sword->God)" then
                            State.HasAwakenedThisMatch = true
                        end
                    end
                end
                return
            else
                State.IsAwaking = false
            end
        end
    else
        State.IsAwaking = false
    end

    local effectsFolder = getMapEffectsFolder()
    if not effectsFolder then
        StatusLabel.Text = "Target: Không tìm thấy MapEffects"
        return
    end

    if not State.CurrentTarget or not State.CurrentTarget:IsDescendantOf(effectsFolder) then
        State.CurrentTarget = acquireNextMob(effectsFolder)
    end

    local currentMob = State.CurrentTarget
    if not currentMob then
        if State.AutoTele or State.AutoArise then
            StatusLabel.Text = "Mob Target: Đang chờ quái xuất hiện..."
        end
        return
    end

    StatusLabel.Text = "Mob Target: " .. currentMob.Name

    if State.AutoTele and not State.IsAwaking then
        local mobPart = getMobPivotPart(currentMob)
        if mobPart then
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.lookAt(mobPart.Position + State.TeleOffset, mobPart.Position)
            end
        end
    end

    if State.AutoArise and not State.IsAwaking then
        if now - State.LastAriseTime >= State.AriseInterval then
            State.LastAriseTime = now
            triggerOptimizedArise(currentMob)
        end
    end
end)

